{
  "name": "planet-of-gemstones",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Planet of Gemstones — ديوان الأحجار الكريمة. Bilingual 3D jewelry storefront (Nuxt 3 + Tailwind + Three.js).",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && node scripts/fix-vue-types.mjs && node scripts/copy-draco.mjs",
    "typecheck": "nuxt prepare && node scripts/fix-vue-types.mjs && vue-tsc --noEmit",
    "og-image": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "nuxt": "^3.21.11",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@nuxt/image": "^1.11.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^2.2.12"
  },
  "engines": {
    "node": ">=20"
  }
}
